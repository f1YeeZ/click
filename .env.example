DB_URL=jdbc:postgresql://localhost:5432/click
DB_USERNAME=postgres
DB_PASSWORD=change-me

QQ_MAIL_USERNAME=your-qq-number@qq.com
QQ_MAIL_AUTH_CODE=replace-with-your-new-mail-auth-code
QQ_MAIL_FROM=your-qq-number@qq.com
MAIL_ENABLED=false
VERIFICATION_CODE_EXPIRES_SECONDS=60
VERIFICATION_CODE_RESEND_SECONDS=60

APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=
APP_SEED_ADMIN_PASSWORD=

BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_HOURS=24
JWT_ISSUER=clicker-index
JWT_AUDIENCE=clicker-index-web
ANALYTICS_HASH_SALT=replace-with-a-separate-random-secret
SSE_MAX_CONNECTIONS=5000
SSE_MAX_CONNECTIONS_PER_ADDRESS=50
SSE_HEARTBEAT_MS=25000
SSE_FANOUT_THREADS=8
TOMCAT_MAX_CONNECTIONS=10000
