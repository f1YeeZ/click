# 复制为 .env 后再执行 docker compose。不要提交真实值。
POSTGRES_DB=clicker
POSTGRES_USER=clicker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# 至少 48 个随机字符，例如：openssl rand -base64 48
JWT_SECRET=replace-with-at-least-48-random-characters-before-deploy
JWT_EXPIRES_HOURS=24
ANALYTICS_HASH_SALT=replace-with-a-separate-random-secret

# 必须是最终 HTTPS 站点来源，不要以斜杠结尾。
PUBLIC_ORIGIN=https://mouse.example.com
# 仅填写实际反向代理/容器网段，禁止把公网网段加入信任列表。
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32,::1/128
APP_HTTP_PORT=8080
OPERATOR_NAME=请替换为真实运营主体名称
LEGAL_CONTACT_EMAIL=privacy@mouse.example.com

# 单实例实时连接容量；上线前应按服务器配置完成压力测试。
SSE_MAX_CONNECTIONS=5000
SSE_MAX_CONNECTIONS_PER_ADDRESS=50
SSE_HEARTBEAT_MS=25000
SSE_FANOUT_THREADS=8
TOMCAT_MAX_CONNECTIONS=10000

QQ_MAIL_USERNAME=your-qq-number@qq.com
QQ_MAIL_AUTH_CODE=replace-with-qq-smtp-auth-code
QQ_MAIL_FROM=your-qq-number@qq.com
VERIFICATION_CODE_EXPIRES_SECONDS=60
VERIFICATION_CODE_RESEND_SECONDS=60

# 首次启动可填写以创建管理员；创建成功并确认登录后建议从 .env 移除密码。
APP_SEED_ADMIN_EMAIL=2111914551@qq.com
APP_SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
